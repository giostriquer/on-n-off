{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "on-n-off",
  "version": "0.1.11",
  "identifier": "app.on-n-off.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "on-n-off",
        "width": 1120,
        "height": 760,
        "minWidth": 960,
        "minHeight": 640,
        "backgroundColor": "#191c20"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEyQTREQjA5RkYwQkQ3ODIKUldTQzF3di9DZHVrRXIwdEZ2Z1FHV1NVVHlvZWM5YXBMUlRsQ0pRUDM5SFZZY2VmanB5LzhFMEQK",
      "endpoints": [
        "https://github.com/giostriquer/on-n-off/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg"],
    "resources": {
      "../LICENSE": "LICENSE",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
